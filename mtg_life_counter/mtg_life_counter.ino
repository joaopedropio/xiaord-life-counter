void rollDice(int sides) {
  showScreen(S_DICE_RESULT);
  fb.setTextDatum(MC_DATUM);
  fb.setTextPadding(0);
  fb.setTextColor(GREY, TFT_BLACK);
  fb.drawString("d" + String(sides), CX, 40, 4);
  drawIcon(I_BACK, CX, 205, GREY, TFT_BLACK);   // any tap goes back
  markDirty(0, 0, W, H);
  flush();

  // short shuffle animation, then the real roll
  for (int i = 0; i < 8; i++) {
    drawDiceNumber(random(1, sides + 1), GREY);
    delay(50);
  }
  int v = random(1, sides + 1);
  uint16_t color = (v == sides) ? TFT_GREEN : (v == 1 ? TFT_RED : TFT_WHITE);
  drawDiceNumber(v, color);
  DBG("dice d%d -> %d", sides, v);
}

// Backlight PWM on D6 (active high). Low-battery mode dims it, except on the
// brightness screen, which shows the chosen value while it is being set.
void applyBrightness() {
  int b = (lowBattery && screen != S_BRIGHT) ? LOW_BAT_BRIGHT : brightness;
  analogWrite(BACKLIGHT, b * 255 / 100);
}

