// round thumbnail of a custom slot's background, centered on (cx, cy)
void drawSlotThumb(int slot, int cx, int cy, int r) {
  const CustomTheme *h = ctHeader(slot);
  const uint16_t *pal = (const uint16_t *)((const uint8_t *)h + 64);
  const uint8_t *px = ctPixels(slot);
  for (int y = -r; y <= r; y++)
    for (int x = -r; x <= r; x++) {
      if (x * x + y * y > r * r) continue;
      int sx = 120 + x * 120 / r, sy = 120 + y * 120 / r;
      fb.drawPixel(cx + x, cy + y, pal[px[constrain(sy, 0, 239) * W + constrain(sx, 0, 239)]]);
    }
}

void drawThemePicker() {
  showScreen(S_THEME);
  fb.setTextDatum(MC_DATUM);
  fb.setTextPadding(0);
  for (int i = 0; i < THEME_COUNT; i++) {
    const Btn &b = THEME_BTNS[i];
    const Theme &t = THEMES[i];
    uint16_t fill = (i == 0) ? BTN_FILL : t.accent;
    fb.fillRoundRect(b.x, b.y, b.w, b.h, 10, fill);
    fb.drawRoundRect(b.x, b.y, b.w, b.h, 10, i == theme ? TFT_WHITE : t.ring);
    if (i == theme) fb.drawRoundRect(b.x + 1, b.y + 1, b.w - 2, b.h - 2, 9, TFT_WHITE);
    fb.setTextColor(i == 0 ? TFT_WHITE : TFT_BLACK, fill);
    fb.drawString(THEME_LABELS[i], b.x + b.w / 2, b.y + b.h / 2 + 1, 4);
  }
  for (int k = 0; k < CT_SLOTS; k++) {
    const Btn &b = THEME_BTNS[THEME_COUNT + k];
    bool sel = theme == THEME_COUNT + k;
    fb.fillRoundRect(b.x, b.y, b.w, b.h, 10, BTN_FILL);
    if (ctValid[k]) {
      drawSlotThumb(k, b.x + b.w / 2, b.y + b.h / 2, b.h / 2 - 4);
      fb.drawRoundRect(b.x, b.y, b.w, b.h, 10, sel ? TFT_WHITE : ctHeader(k)->acc);
      if (sel) fb.drawRoundRect(b.x + 1, b.y + 1, b.w - 2, b.h - 2, 9, TFT_WHITE);
    } else {
      fb.drawRoundRect(b.x, b.y, b.w, b.h, 10, 0x39E7);
      fb.setTextColor(GREY, BTN_FILL);
      fb.drawString(String(k + 1), b.x + b.w / 2, b.y + b.h / 2 + 1, 4);   // empty slot
    }
  }
  drawButton(THEME_BTNS[THEME_BT], bleAdvertising || bleConnected ? 0x3CBF : btnBorder());
  drawButton(THEME_BTNS[THEME_LAYOUT], btnBorder());
  drawButton(THEME_BTNS[THEME_BACK], btnBorder());
  markDirty(0, 0, W, H);
  flush();
}

