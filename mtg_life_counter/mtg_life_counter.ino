// ================= Fast display flush =================
// Dirty rectangle (inclusive) accumulated since the last flush.
int dx0 = W, dy0 = H, dx1 = -1, dy1 = -1;

void markDirty(int x, int y, int w, int h) {
  if (w <= 0 || h <= 0) return;
  dx0 = min(dx0, max(x, 0));
  dy0 = min(dy0, max(y, 0));
  dx1 = max(dx1, min(x + w - 1, W - 1));
  dy1 = max(dy1, min(y + h - 1, H - 1));
}

void flush() {
  if (dx1 < dx0 || dy1 < dy0) return;
  int w = dx1 - dx0 + 1;

  tft.startWrite();                                   // CS low + SPI transaction
  SPI.setClockDivider(SPI_32MHZ ? SPI_CLOCK_DIV2 : SPI_CLOCK_DIV4);
  tft.setWindow(dx0, dy0, dx1, dy1);                  // leaves DC in data mode
  if (w == W) {
    // full-width rows are contiguous: one DMA transfer (split in 64 KB chunks by the core)
    SPI.transfer(fbPix + dy0 * W, (void *)nullptr, (size_t)w * (dy1 - dy0 + 1) * 2);
  } else {
    for (int y = dy0; y <= dy1; y++)
      SPI.transfer(fbPix + y * W + dx0, (void *)nullptr, (size_t)w * 2);
  }
  tft.endWrite();

  dx0 = W; dy0 = H; dx1 = -1; dy1 = -1;
}

// ================= Touch =================
// NOTE: the CHSC6X INT line PULSES low once per new report; it does NOT stay low
// while the finger is down. So INT only means "a new report is ready", and the
// end of a touch is detected by RELEASE_MS without any valid report.
bool touchReady() {
  return digitalRead(TOUCH_INT) == LOW;
}

// The core's Wire.requestFrom() busy-waits on the TWIM events with NO timeout, so
// a single lost/stretched transfer from the touch chip froze the whole sketch.
// This reads the touch directly on TWIM0 (the peripheral Wire set up) with a
// timeout, and recovers the bus if it gets stuck.
NRF_TWIM_Type *const TWIM = NRF_TWIM0;
const uint32_t I2C_TIMEOUT_US = 5000;   // a 5-byte read at 100 kHz takes ~0.6 ms
uint32_t i2cErrors = 0, i2cTimeouts = 0;

// Free a stuck bus: clock SCL up to 9 times until the slave releases SDA,
// send a STOP, then let Wire reconfigure the peripheral.
void i2cRecover() {
  TWIM->TASKS_STOP = 1;
  TWIM->ENABLE = TWIM_ENABLE_ENABLE_Disabled << TWIM_ENABLE_ENABLE_Pos;
  // open-drain emulation: OUTPUT LOW = pull down, INPUT_PULLUP = release
  pinMode(PIN_WIRE_SDA, INPUT_PULLUP);
  for (int i = 0; i < 9 && digitalRead(PIN_WIRE_SDA) == LOW; i++) {
    pinMode(PIN_WIRE_SCL, OUTPUT); digitalWrite(PIN_WIRE_SCL, LOW);
    delayMicroseconds(5);
    pinMode(PIN_WIRE_SCL, INPUT_PULLUP);
    delayMicroseconds(5);
  }
  // STOP: SDA low -> high while SCL is high
  pinMode(PIN_WIRE_SDA, OUTPUT); digitalWrite(PIN_WIRE_SDA, LOW);
  delayMicroseconds(5);
  pinMode(PIN_WIRE_SCL, INPUT_PULLUP);
  delayMicroseconds(5);
  pinMode(PIN_WIRE_SDA, INPUT_PULLUP);
  delayMicroseconds(5);
  Wire.begin();
}

// Waits for an event with a timeout. Returns false on timeout.
bool twimWait(volatile uint32_t &event, uint32_t t0) {
  while (!event) {
    if (micros() - t0 > I2C_TIMEOUT_US) return false;
  }
  return true;
}

bool i2cRead(uint8_t addr, uint8_t *dst, uint8_t n) {
  static uint8_t rx[8];                 // EasyDMA buffer must be in RAM
  if (n > sizeof(rx)) return false;

  TWIM->EVENTS_STOPPED = 0;
  TWIM->EVENTS_ERROR = 0;
  TWIM->EVENTS_LASTRX = 0;
  TWIM->ERRORSRC = TWIM->ERRORSRC;      // write-1-to-clear
  TWIM->ADDRESS = addr;
  TWIM->RXD.PTR = (uint32_t)rx;
  TWIM->RXD.MAXCNT = n;
  TWIM->SHORTS = TWIM_SHORTS_LASTRX_STOP_Msk; // send STOP automatically after the last byte
  TWIM->TASKS_RESUME = 1;
  TWIM->TASKS_STARTRX = 1;

  uint32_t t0 = micros();
  bool ok = true;
  while (!TWIM->EVENTS_STOPPED) {
    if (TWIM->EVENTS_ERROR) {           // NACK / overrun: stop and bail out
      TWIM->TASKS_STOP = 1;
      if (!twimWait(TWIM->EVENTS_STOPPED, micros())) { i2cTimeouts++; i2cRecover(); }
      i2cErrors++;
      ok = false;
      break;
    }
    if (micros() - t0 > I2C_TIMEOUT_US) {
      i2cTimeouts++;
      DBG("i2c timeout -> bus recovery");
      i2cRecover();
      ok = false;
      break;
    }
  }
  TWIM->SHORTS = 0;
  TWIM->EVENTS_STOPPED = 0;
  TWIM->EVENTS_ERROR = 0;
  if (!ok || TWIM->RXD.AMOUNT != n) return false;
  memcpy(dst, rx, n);
  return true;
}

bool readTouch(int &x, int &y) {
  uint8_t buf[5];
  if (!i2cRead(TOUCH_ADDR, buf, 5)) return false;
  if (buf[0] != 0x01) return false;
  x = buf[2];
  y = buf[4];
  return true;
}

// ================= Persistence (raw internal flash, append-only log) =================
// Two 4 KB flash pages hold a log of 16-byte records. A save appends one record
// to the active page (4 word writes, well under 1 ms, no erase). Only when that
// page is full is the OTHER page erased (~85 ms) and used next; the full page
// stays intact until then, so a power cut at any moment leaves the last good
// record readable. On boot the valid record with the highest seq wins.
//
// The pages are the last two of the area the linker reserves for InternalFS
// (0xED000-0xF4000, below the bootloader at 0xF4000). Nothing else in this
// sketch uses InternalFS, and firmware uploads never touch that area.
// Writes use sd_flash_* once BLE (the SoftDevice) is on, the NVMC directly before.
const uint32_t PAGE_SIZE = 4096;
const uint32_t STATE_PAGES[2] = { 0xF2000, 0xF3000 };
const int SLOTS_PER_PAGE = PAGE_SIZE / sizeof(SavedState);   // 256

int      activePage = -1;   // page holding the newest record (-1: none yet)
int      nextSlot = 0;      // where the next record goes in activePage
bool     activeAppendable = false;
uint32_t lastSeq = 0;

// Hashes every word before `check`. The seed changed from "MTG1" when the record
// grew from 12 to 16 bytes, so old records never pass as new ones.
uint32_t stateCheck(const SavedState &s) {
  uint32_t h = 0x4D544732;                        // "MTG2"
  const uint32_t *w = (const uint32_t *)&s;
  for (unsigned i = 0; i < sizeof(SavedState) / 4 - 1; i++) h = (h ^ w[i]) * 0x9E3779B1u;
  return h ^ (h >> 15);
}

// position of `secs` in SLEEP_SECS, or -1
int sleepIndexOf(int secs) {
  for (int i = 0; i < SLEEP_OPTIONS; i++) if (SLEEP_SECS[i] == secs) return i;
  return -1;
}

const SavedState *slotPtr(int page, int slot) {
  return (const SavedState *)(STATE_PAGES[page] + slot * sizeof(SavedState));
}

bool slotErased(const SavedState *r) {
  const uint32_t *w = (const uint32_t *)r;
  for (unsigned i = 0; i < sizeof(SavedState) / 4; i++) if (w[i] != 0xFFFFFFFF) return false;
  return true;
}

bool slotValid(const SavedState *r) {
  return r->seq != 0xFFFFFFFF && r->check == stateCheck(*r) &&
         (r->startingLife == 20 || r->startingLife == 40) &&
         r->brightness >= BRIGHT_MIN && r->brightness <= 100 && sleepIndexOf(r->sleep5s * 5) >= 0 &&
         r->life >= -999 && r->life <= 999;
}

void nvmcWait() { while (NRF_NVMC->READY == NVMC_READY_READY_Busy) {} }

// With BLE on, the SoftDevice owns the NVMC: flash ops go through sd_flash_* and run
// asynchronously between radio events. We wait for them by watching the flash
// contents (the SoC event also arrives, but Bluefruit hands it to InternalFS).
bool sdEnabled() {
  uint8_t en = 0;
  sd_softdevice_is_enabled(&en);
  return en;
}

bool pageBlank(uint32_t addr) {
  const uint32_t *w = (const uint32_t *)addr;
  for (uint32_t i = 0; i < PAGE_SIZE / 4; i++) if (w[i] != 0xFFFFFFFF) return false;
  return true;
}

void flashErasePage(uint32_t addr) {
  if (sdEnabled()) {
    while (sd_flash_page_erase(addr / PAGE_SIZE) == NRF_ERROR_BUSY) delay(1);
    unsigned long t0 = millis();
    while (!pageBlank(addr) && millis() - t0 < 500) delay(1);
    return;
  }
  NRF_NVMC->CONFIG = NVMC_CONFIG_WEN_Een << NVMC_CONFIG_WEN_Pos;
  nvmcWait();
  NRF_NVMC->ERASEPAGE = addr;
  nvmcWait();
  NRF_NVMC->CONFIG = NVMC_CONFIG_WEN_Ren << NVMC_CONFIG_WEN_Pos;
  nvmcWait();
}

void flashWriteWords(uint32_t addr, const uint32_t *src, int n) {
  if (sdEnabled()) {
    while (n > 0) {
      int k = min(n, 256);              // 1 KB per op (S140 has trouble with whole pages)
      while (sd_flash_write((uint32_t *)addr, src, k) == NRF_ERROR_BUSY) delay(1);
      unsigned long t0 = millis();
      while (memcmp((const void *)addr, src, k * 4) != 0 && millis() - t0 < 200) delay(1);
      addr += k * 4; src += k; n -= k;
    }
    return;
  }
  NRF_NVMC->CONFIG = NVMC_CONFIG_WEN_Wen << NVMC_CONFIG_WEN_Pos;
  nvmcWait();
  for (int i = 0; i < n; i++) {
    ((volatile uint32_t *)addr)[i] = src[i];
    nvmcWait();
  }
  NRF_NVMC->CONFIG = NVMC_CONFIG_WEN_Ren << NVMC_CONFIG_WEN_Pos;
  nvmcWait();
}

void loadState() {
  const SavedState *best = nullptr;
  for (int p = 0; p < 2; p++) {
    // valid records are written contiguously from slot 0
    int i = 0;
    const SavedState *newest = nullptr;
    while (i < SLOTS_PER_PAGE && slotValid(slotPtr(p, i))) { newest = slotPtr(p, i); i++; }
    if (newest && (!best || newest->seq > best->seq)) {
      best = newest;
      activePage = p;
      nextSlot = i;
      // appendable only if the slot after the last record is still blank
      activeAppendable = (i < SLOTS_PER_PAGE) && slotErased(slotPtr(p, i));
    }
  }
  if (!best) { DBG("no saved state"); return; }
  lastSeq = best->seq;
  life = best->life;
  startingLife = best->startingLife;
  brightness = best->brightness;
  sleepIdx = sleepIndexOf(best->sleep5s * 5);
  int t = best->theme & 0x0F;
  theme = t < THEME_COUNT + CT_SLOTS ? t : 0;  // custom slots are checked in ctInit()
  fontIdx = best->font < FONT_COUNT ? best->font : 0;
  if (best->layout != 0xFF) {
    int l = best->layout & 0x0F, m = (best->layout >> 4) & 0x07;
    lifeLayout = l < LIFE_LAYOUTS ? l : L_CLASSIC;
    menuLayout = m < MENU_LAYOUTS ? m : ML_GRID;
    menuBg = !(best->layout & 0x80);
  }
  DBG("loaded life=%d start=%d (page %d slot %d seq %lu)",
      life, startingLife, activePage, nextSlot - 1, lastSeq);
}

void saveState() {
  saveDirty = false;
  SavedState s = { lastSeq + 1, (int16_t)life, (uint8_t)startingLife, (uint8_t)brightness,
                   (uint8_t)(SLEEP_SECS[sleepIdx] / 5), (uint8_t)fontIdx,
                   (uint8_t)(lifeLayout | menuLayout << 4 | (menuBg ? 0 : 0x80)),
                   (uint8_t)theme, 0 };
  s.check = stateCheck(s);
  unsigned long t0 = micros();

  if (activePage < 0 || !activeAppendable || nextSlot >= SLOTS_PER_PAGE) {
    // move to the other page (or page 0 the first time): erase it, start at slot 0
    activePage = (activePage < 0) ? 0 : 1 - activePage;
    flashErasePage(STATE_PAGES[activePage]);
    nextSlot = 0;
    activeAppendable = true;
  }
  uint32_t addr = (uint32_t)slotPtr(activePage, nextSlot);
  flashWriteWords(addr, (const uint32_t *)&s, sizeof(s) / 4);

  if (!slotValid(slotPtr(activePage, nextSlot))) {   // verify; on failure retry on the other page next time
    DBG("save verify FAILED at 0x%lx", addr);
    activeAppendable = false;
    saveDirty = true;
    saveDirtySince = millis();
    return;
  }
  lastSeq = s.seq;
  nextSlot++;
  DBG("saved life=%d theme=%d font=%d start=%d bright=%d sleep=%ds (page %d slot %d seq %lu) in %lu us",
      life, theme, fontIdx, startingLife, brightness, SLEEP_SECS[sleepIdx], activePage, nextSlot - 1, lastSeq, micros() - t0);
}

void requestSave() {
  saveDirty = true;
  saveDirtySince = millis();
}

// ================= Drawing (into the framebuffer) =================
// ---- anti-aliased big digits (fonts from tools/make_bigfont.py) ----
const BigGlyph *bigGlyph(const BigFont &f, char c) {
  for (int i = 0; i < f.count; i++) if (f.glyphs[i].ch == c) return &f.glyphs[i];
  return nullptr;
}

// ink extent of `s` relative to the pen start
void bigExtent(const BigFont &f, const String &s, int &minX, int &maxX) {
  int pen = 0;
  minX = 10000; maxX = -10000;
  for (unsigned i = 0; i < s.length(); i++) {
    const BigGlyph *g = bigGlyph(f, s[i]);
    if (!g) continue;
    minX = min(minX, pen + g->dx);
    maxX = max(maxX, pen + g->dx + g->w);
    pen += g->adv;
  }
  if (maxX < minX) minX = maxX = 0;
}

int bigWidth(const BigFont &f, const String &s) {
  int a, b;
  bigExtent(f, s, a, b);
  return b - a;
}

// ---- custom theme helpers ----
// The custom theme in use, or null. Only the life screen shows it; the menus stay
// black with the theme's accent colors.
const CustomTheme *activeCustom() {
  return theme >= THEME_COUNT ? ctHeader(theme - THEME_COUNT) : nullptr;
}
const CustomTheme *lifeCustom() { return screen == S_LIFE ? activeCustom() : nullptr; }

uint16_t ringColor()   { const CustomTheme *c = activeCustom(); return c ? c->acc2 : THEMES[theme].ring; }
uint16_t accentColor() { const CustomTheme *c = activeCustom(); return c ? c->acc : THEMES[theme].accent; }

inline uint16_t swap16(uint16_t v) { return (v >> 8) | (v << 8); }

// a custom theme can carry a life-number font (picked on the web page): switch to it
// when the theme is chosen (not at boot: the saved font wins there)
void applyThemeFont() {
  const CustomTheme *c = activeCustom();
  if (c && c->font >= 1 && c->font <= FONT_COUNT) fontIdx = c->font - 1;
}

// call whenever `theme` changes: loads the custom palette
void themeChanged() {
  const CustomTheme *c = activeCustom();
  if (!c) return;
  const uint16_t *pal = (const uint16_t *)((const uint8_t *)c + 64);
  for (int i = 0; i < 256; i++) ctPal[i] = swap16(pal[i]);
}

// The custom image shows on the life screen, and behind the main menu unless turned off.
const CustomTheme *bgCustom() {
  if (screen == S_LIFE || (screen == S_MENU && menuBg)) return activeCustom();
  return nullptr;
}

// ---- life screen background, per layout ----
// The ring / ticks / hints / halo / life bar are part of the background: restoreBg()
// recomputes them pixel by pixel, so erasing the number or the dot never cuts them.
const int RING_LO = 107 * 107 - 107, RING_HI = 110 * 110 + 110;   // r 106.5 .. 110.5
const int THIN_LO = 11751, THIN_HI = 12012;                       // r 108.4 .. 109.6
const int TICK_LO = 100 * 100, TICK_HI = 111 * 111;
const int HALO_N = 452;                 // indexed by r^2 / 64 (corners: 28800 / 64 = 450)
uint16_t haloLut[HALO_N];               // byte-swapped
uint16_t bgRing, bgDim, bgThin, bgHintMinus, bgHintPlus;   // RGB565
float    barShownDeg = 0;               // L_LIFEBAR: lit part of the ring, degrees from the top
uint16_t barShownCol = 0;
uint16_t tickCol[24];
bool     tickLit[24];

// 0 = top, clockwise, 0..360
float angTop(int dx, int dy) {
  float a = atan2f((float)dx, (float)-dy) * (180.0f / PI);
  return a < 0 ? a + 360.0f : a;
}

float barDeg() {
  if (startingLife <= 0) return 0;
  return constrain((float)life / startingLife, 0.0f, 1.0f) * 360.0f;
}

void prepTicks() {
  uint16_t ring = ringColor(), acc = accentColor();
  for (int k = 0; k < 24; k++) {
    float d = 999;
    if (tickShown >= 0) { d = fabsf(k * 15.0f - tickShown); if (d > 180) d = 360 - d; }
    tickLit[k] = d <= 30;
    tickCol[k] = tickLit[k] ? fb.alphaBlend((uint8_t)(255 * (1 - d / 45)), acc, ring) : ring;
  }
}

// call before repainting the life screen (theme, layout or starting life may have changed)
void prepLifeBg() {
  const CustomTheme *c = activeCustom();
  bgRing = ringColor();
  bgDim  = fb.alphaBlend(115, bgRing, TFT_BLACK);
  bgThin = fb.alphaBlend(153, bgRing, TFT_BLACK);
  bgHintMinus = c ? c->minus : TFT_RED;
  bgHintPlus  = c ? c->plus : TFT_GREEN;
  if (lifeLayout == L_HALO) {
    uint16_t acc = accentColor();
    for (int i = 0; i < HALO_N; i++) {
      float r = sqrtf(i * 64.0f + 32) / 120.0f;
      float a = r < 0.55f ? 0.24f - 0.16f * r / 0.55f : (r < 1 ? 0.08f * (1 - (r - 0.55f) / 0.45f) : 0);
      haloLut[i] = swap16(fb.alphaBlend((uint8_t)(a * 255), acc, TFT_BLACK));
    }
  }
  barShownDeg = barDeg();
  barShownCol = lifeColor(life);
  prepTicks();
}

inline uint16_t hintPx(uint16_t col, uint16_t baseSw) {
  return swap16(fb.alphaBlend(115, col, swap16(baseSw)));
}

// one background pixel of the life screen (byte-swapped, like fbPix)
uint16_t lifeBgPixel(int x, int y, const CustomTheme *c, const uint8_t *img) {
  int dx = x - CX, dy = y - CY, r2 = dx * dx + dy * dy;
  uint16_t base = c ? ctPal[img[y * W + x]] : (lifeLayout == L_HALO ? haloLut[min(r2 >> 6, HALO_N - 1)] : 0);
  switch (lifeLayout) {
    case L_CLASSIC:
    case L_HISTORY:
      if (!c && r2 >= RING_LO && r2 <= RING_HI) return swap16(bgRing);
      break;
    case L_HALO:
      if (!c && r2 >= THIN_LO && r2 <= THIN_HI) return swap16(bgThin);
      break;
    case L_HINTS:                       // ring open at the bottom, faint - and + at the sides
      if (!c && r2 >= RING_LO && r2 <= RING_HI) {
        float a = angTop(dx, dy);
        if (a < 160 || a > 200) return swap16(bgRing);
      }
      if (dy >= -2 && dy <= 2 && dx >= -88 && dx <= -72) return hintPx(bgHintMinus, base);
      if ((dy >= -2 && dy <= 2 && dx >= 72 && dx <= 88) || (dx >= 78 && dx <= 82 && dy >= -8 && dy <= 8))
        return hintPx(bgHintPlus, base);
      break;
    case L_LIFEBAR:                     // lit part = life / starting life
      if (r2 >= RING_LO && r2 <= RING_HI) {
        if (angTop(dx, dy) < barShownDeg) return swap16(barShownCol);
        if (!c) return swap16(bgDim);
      }
      break;
    case L_TICKS:                       // 24 ticks, one per life on the slider
      if (r2 >= TICK_LO && r2 <= TICK_HI) {
        float a = angTop(dx, dy);
        int k = (int)lroundf(a / 15.0f);
        float off = fabsf(a - k * 15.0f) * (PI / 180.0f) * sqrtf((float)r2);
        k %= 24;
        if (off <= (tickLit[k] ? 2.0f : 1.5f)) return swap16(tickCol[k]);
      }
      break;
  }
  return base;
}

// Repaints a rect of the screen background (life screen: per layout; menus: black or
// the custom image). Does not mark it dirty.
void restoreBg(int x, int y, int w, int h) {
  if (x < 0) { w += x; x = 0; }
  if (y < 0) { h += y; y = 0; }
  if (x + w > W) w = W - x;
  if (y + h > H) h = H - y;
  if (w <= 0 || h <= 0) return;
  const CustomTheme *c = bgCustom();
  const uint8_t *img = c ? ctPixels(theme - THEME_COUNT) : nullptr;
  if (screen != S_LIFE) {
    if (!c) { fb.fillRect(x, y, w, h, TFT_BLACK); return; }
    for (int yy = y; yy < y + h; yy++) {
      uint16_t *d = fbPix + yy * W + x;
      const uint8_t *src = img + yy * W + x;
      for (int i = 0; i < w; i++) d[i] = ctPal[src[i]];
    }
    return;
  }
  for (int yy = y; yy < y + h; yy++) {
    uint16_t *d = fbPix + yy * W + x;
    for (int i = 0; i < w; i++) d[i] = lifeBgPixel(x + i, yy, c, img);
  }
}

// repaints the background ring pixels (rIn..rOut) between angles a0..a1 (from the top,
// clockwise) and marks their bounding box dirty
void repaintRim(float a0, float a1, int rIn, int rOut) {
  int x0 = W, y0 = H, x1 = -1, y1 = -1;
  if (a1 - a0 >= 360) { x0 = CX - rOut; y0 = CY - rOut; x1 = CX + rOut; y1 = CY + rOut; }
  else {
    for (float a = a0; ; a += 5) {
      if (a > a1) a = a1;
      float s = sinf(a * PI / 180), co = cosf(a * PI / 180);
      for (int r = rIn; r <= rOut; r += rOut - rIn) {
        int px = CX + (int)lroundf(r * s), py = CY - (int)lroundf(r * co);
        x0 = min(x0, px); x1 = max(x1, px); y0 = min(y0, py); y1 = max(y1, py);
      }
      if (a >= a1) break;
    }
  }
  x0 = max(x0 - 3, 0); y0 = max(y0 - 3, 0); x1 = min(x1 + 3, W - 1); y1 = min(y1 + 3, H - 1);
  const CustomTheme *c = bgCustom();
  const uint8_t *img = c ? ctPixels(theme - THEME_COUNT) : nullptr;
  int lo = rIn * rIn - rIn, hi = rOut * rOut + rOut;
  for (int y = y0; y <= y1; y++)
    for (int x = x0; x <= x1; x++) {
      int dx = x - CX, dy = y - CY, r2 = dx * dx + dy * dy;
      if (r2 >= lo && r2 <= hi) fbPix[y * W + x] = lifeBgPixel(x, y, c, img);
    }
  markDirty(x0, y0, x1 - x0 + 1, y1 - y0 + 1);
}

// Draws `s` centered on (cx, cy). Anti-aliasing blends with black, or with what is
// already in the framebuffer when a custom background is showing. `grad` (3 colors,
// top / middle / bottom) paints a vertical gradient instead of `color`.
void drawBig(const BigFont &f, const String &s, int cx, int cy, uint16_t color,
             const uint16_t *grad = nullptr) {
  int minX, maxX;
  bigExtent(f, s, minX, maxX);
  int x0 = cx - (maxX - minX) / 2 - minX;
  int y0 = cy - (f.top + f.height / 2);
  bool blend = screen == S_LIFE;         // blend with the background already in the framebuffer
  uint16_t shade[16];
  for (int a = 0; a < 16; a++) shade[a] = fb.alphaBlend(a * 17, color, TFT_BLACK);
  int pen = 0;
  for (unsigned i = 0; i < s.length(); i++) {
    const BigGlyph *g = bigGlyph(f, s[i]);
    if (!g) continue;
    const uint8_t *bm = f.bitmap + g->off;
    int gx = x0 + pen + g->dx, gy = y0 + g->dy;
    for (int y = 0, k = 0; y < g->h; y++) {
      int py = gy + y;
      uint16_t c = color;
      if (grad) {                       // position within the font's digit box
        int t = constrain((py - (y0 + f.top)) * 510 / max(1, (int)f.height), 0, 510);
        c = t < 255 ? fb.alphaBlend(t, grad[1], grad[0]) : fb.alphaBlend(t - 255, grad[2], grad[1]);
      }
      for (int x = 0; x < g->w; x++, k++) {
        int a = (k & 1) ? (bm[k >> 1] & 0x0F) : (bm[k >> 1] >> 4);
        if (!a) continue;
        int px = gx + x;
        if (px < 0 || px >= W || py < 0 || py >= H) continue;
        if (!blend && !grad) { fb.drawPixel(px, py, shade[a]); continue; }
        uint16_t bg = blend ? swap16(fbPix[py * W + px]) : TFT_BLACK;
        fb.drawPixel(px, py, a == 15 ? c : fb.alphaBlend(a * 17, c, bg));
      }
    }
    pen += g->adv;
  }
}

void drawRing() {
  // guide ring showing where the slider lives (theme color); custom images have their own
  if (lifeCustom()) return;
  for (int r = 107; r <= 110; r++) fb.drawCircle(CX, CY, r, ringColor());
}

// The dot (r 90..106 from center) never touches the ring (r 106.5..110.5).
void redrawMarkerIfIn(int x, int y, int w, int h) {
  if (markerX < 0 || markerX + 9 < x || markerX - 9 >= x + w || markerY + 9 < y || markerY - 9 >= y + h) return;
  fb.fillCircle(markerX, markerY, 8, accentColor());
  markDirty(markerX - 9, markerY - 9, 19, 19);
}

void drawMarker() {
  if (wantMarkerX == markerX && wantMarkerY == markerY) return;
  if (markerX >= 0) {
    int ex = markerX - 9, ey = markerY - 9;
    markerX = markerY = -1;
    restoreBg(ex, ey, 19, 19);
    markDirty(ex, ey, 19, 19);
    repaintOverlaps(ex, ey, 19, 19);    // the dot may have covered part of the number / text
  }
  if (wantMarkerX >= 0) {
    fb.fillCircle(wantMarkerX, wantMarkerY, 8, accentColor());
    markDirty(wantMarkerX - 9, wantMarkerY - 9, 19, 19);
  }
  markerX = wantMarkerX;
  markerY = wantMarkerY;
}

// L_TICKS: the ticks near the finger light up (no dot)
void drawTicks() {
  if (tickWant == tickShown) return;
  float old = tickShown;
  tickShown = tickWant;
  prepTicks();
  if (old >= 0) repaintRim(old - 45, old + 45, 100, 111);
  if (tickShown >= 0) repaintRim(tickShown - 45, tickShown + 45, 100, 111);
}

uint16_t lifeColor(int v) {
  const CustomTheme *c = lifeCustom();
  if (v <= 0)  return c ? c->warn[2] : TFT_RED;
  if (v <= 5)  return c ? c->warn[1] : TFT_ORANGE;
  if (v <= 10) return c ? c->warn[0] : TFT_YELLOW;
  return c ? c->num : TFT_WHITE;
}

const int LIFE_W = 200, LIFE_H = 82;   // area cleared behind the big number
int numY()   { return lifeLayout == L_HISTORY ? CY - 16 : CY; }
int deltaY() { return lifeLayout == L_HISTORY ? CY - 76 : CY - 62; }

// draws `v` with the chosen font: XL when it fits, else L (fits -999..999)
// Custom themes add their effect (shadow / gradient) while the color is the normal one.
void drawNumber(int v, int cy, uint16_t color) {
  String s = String(v);
  const FontChoice &fc = FONTS[fontIdx];
  const BigFont &f = bigWidth(*fc.xl, s) <= LIFE_W - 4 ? *fc.xl : *fc.l;
  const CustomTheme *c = lifeCustom();
  if (c && color == c->num && c->fx == FX_SHADOW) {
    int dx = constrain(c->fxDx, -3, 3), dy = constrain(c->fxDy, -3, 3);
    drawBig(f, s, CX + dx, cy + dy, c->fxColor[0]);
  }
  bool grad = c && color == c->num && c->fx == FX_GRAD;
  drawBig(f, s, CX, cy, color, grad ? c->fxColor : nullptr);
}

void paintNumber() {
  int y = numY() - LIFE_H / 2;
  restoreBg(CX - LIFE_W / 2, y, LIFE_W, LIFE_H);
  drawNumber(life, numY(), lifeColor(life));
  markDirty(CX - LIFE_W / 2, y, LIFE_W, LIFE_H);
  redrawMarkerIfIn(CX - LIFE_W / 2, y, LIFE_W, LIFE_H);
}

void drawLife() {
  paintNumber();
  if (lifeLayout == L_LIFEBAR) {         // the ring follows life / starting life
    float nd = barDeg();
    uint16_t nc = lifeColor(life);
    if (nc != barShownCol) { barShownDeg = nd; barShownCol = nc; repaintRim(0, 360, 107, 110); }
    else if (nd != barShownDeg) {
      float a0 = min(nd, barShownDeg), a1 = max(nd, barShownDeg);
      barShownDeg = nd;
      repaintRim(a0, a1, 107, 110);
    }
  }
}

const int DELTA_W = 90, DELTA_H = 30;

void drawDelta() {
  int y = deltaY();
  restoreBg(CX - DELTA_W / 2, y - DELTA_H / 2, DELTA_W, DELTA_H);
  if (pendingDelta != 0) {
    String s = (pendingDelta > 0 ? "+" : "") + String(pendingDelta);
    const CustomTheme *c = lifeCustom();
    fb.setTextDatum(MC_DATUM);
    fb.setTextPadding(0);
    fb.setTextColor(pendingDelta > 0 ? (c ? c->plus : TFT_GREEN) : (c ? c->minus : TFT_RED));
    fb.drawString(s, CX, y, 4);
  }
  markDirty(CX - DELTA_W / 2, y - DELTA_H / 2, DELTA_W, DELTA_H);
  redrawMarkerIfIn(CX - DELTA_W / 2, y - DELTA_H / 2, DELTA_W, DELTA_H);
}

// L_HISTORY: a thin line under the number and the last changes
const int HIST_X = 50, HIST_Y = 146, HIST_W = 140, HIST_H = 32;

void paintHistory() {
  if (screen != S_LIFE || lifeLayout != L_HISTORY) return;
  restoreBg(HIST_X, HIST_Y, HIST_W, HIST_H);
  const CustomTheme *c = lifeCustom();
  fb.drawFastHLine(64, 152, 112, c ? c->fill : BTN_FILL);
  fb.drawFastHLine(64, 153, 112, c ? c->fill : BTN_FILL);
  fb.setTextDatum(MC_DATUM);
  fb.setTextPadding(0);
  for (int i = 0; i < histCount; i++) {
    int v = hist[i];
    uint16_t col = v > 0 ? (c ? c->plus : TFT_GREEN) : (c ? c->minus : TFT_RED);
    if (!c) col = fb.alphaBlend(190, col, TFT_BLACK);
    fb.setTextColor(col);
    int x = CX + (2 * i - (histCount - 1)) * 21;
    fb.drawString((v > 0 ? "+" : "") + String(v), x, 168, 2);
  }
  markDirty(HIST_X, HIST_Y, HIST_W, HIST_H);
  redrawMarkerIfIn(HIST_X, HIST_Y, HIST_W, HIST_H);
}

void pushHistory(int v) {
  if (histCount == HIST_N) { for (int i = 1; i < HIST_N; i++) hist[i - 1] = hist[i]; histCount--; }
  hist[histCount++] = v;
  paintHistory();
}

// Approximate reading; battery is behind a 1/2 divider on A0.
int batteryPercent() {
  analogReference(AR_INTERNAL_2_4);
  analogReadResolution(12);
  long raw = 0;
  for (int i = 0; i < 16; i++) raw += analogRead(BATTERY_PIN);
  raw /= 16;
  float volts = raw * 2.4f / 4095.0f * 2.0f;
  int pct = (int)((volts - 3.3f) / (4.2f - 3.3f) * 100.0f);
  return constrain(pct, 0, 100);
}

// USB power present. The Round Display's charger has no status line to the MCU,
// so "USB connected" is the best "charging" signal available.
bool usbPowered() {
  return (NRF_POWER->USBREGSTATUS & POWER_USBREGSTATUS_VBUSDETECT_Msk) != 0;
}
bool shownUsb = false;

// small lightning bolt centered on (bx, by), 14 px tall
void drawBolt(int bx, int by, uint16_t color) {
  fb.fillTriangle(bx + 3, by - 7, bx - 4, by + 1, bx + 1, by + 1, color);
  fb.fillTriangle(bx - 1, by - 1, bx + 4, by - 1, bx - 3, by + 7, color);
}

// reads the battery and updates the low-battery mode (does not touch the backlight)
void readBattery() {
  batPct = batteryPercent();
  shownUsb = usbPowered();
  bool usb = shownUsb;
#if DEBUG
  if (batOverride >= 0) { batPct = batOverride; usb = false; }
#endif
  bool low = !usb && (lowBattery ? batPct < LOW_BAT_OFF : batPct <= LOW_BAT_ON);
  if (low != lowBattery) DBG("low battery mode %s (%d%%)", low ? "on" : "off", batPct);
  lowBattery = low;
}

// where the battery goes on each layout
void batteryBox(int &x, int &y, int &w, int &h) {
  switch (lifeLayout) {
    case L_TICKS:   x = 72; y = 176; w = 96; h = 37; break;          // short arc at the bottom
    case L_HINTS:   x = CX - 32; y = CY + 85; w = 64; h = 18; break; // in the ring's gap
    case L_HISTORY: x = CX - 40; y = CY + 73; w = 80; h = 18; break;
    default:        x = CX - 40; y = CY + 72; w = 80; h = 18; break;
  }
}

void paintBattery() {
  if (screen != S_LIFE) return;         // menu covers it; redrawn when the menu closes
  int bx, by, bw, bh;
  batteryBox(bx, by, bw, bh);
  restoreBg(bx, by, bw, bh);
  const CustomTheme *c = lifeCustom();
  uint16_t col = lowBattery ? (c ? c->minus : TFT_RED) : (c ? c->muted : GREY);
  if (lifeLayout == L_TICKS) {
    // arc from 150 to 210 degrees (from the top, clockwise); TFT_eSPI angles start at the bottom
    uint16_t bg = c ? swap16(fbPix[(by + bh / 2) * W + CX]) : TFT_BLACK;
    fb.drawArc(CX, CY, 90, 87, 330, 30, c ? c->fill : BTN_FILL, bg, !c);
    if (batPct > 0) fb.drawArc(CX, CY, 90, 87, (30 - batPct * 60 / 100 + 360) % 360, 30, col, bg, !c);
    if (shownUsb) drawBolt(CX, 186, TFT_YELLOW);
  } else {
    fb.setTextDatum(MC_DATUM);
    fb.setTextPadding(0);
    fb.setTextColor(col);
    String txt = String(batPct) + "%";
    int ty = by + 8;
    int tx = shownUsb ? CX + 8 : CX;    // make room for the bolt
    fb.drawString(txt, tx, ty, 2);
    if (shownUsb) drawBolt(tx - fb.textWidth(txt, 2) / 2 - 9, ty, TFT_YELLOW);
  }
  markDirty(bx, by, bw, bh);
  redrawMarkerIfIn(bx, by, bw, bh);
}

void drawBattery() {
  readBattery();
  paintBattery();
}

// after erasing the dot: repaint whatever it may have covered
void repaintOverlaps(int x, int y, int w, int h) {
  if (screen != S_LIFE) return;
  auto hit = [&](int bx, int by, int bw, int bh) {
    return x < bx + bw && bx < x + w && y < by + bh && by < y + h;
  };
  if (hit(CX - LIFE_W / 2, numY() - LIFE_H / 2, LIFE_W, LIFE_H)) paintNumber();
  if (hit(CX - DELTA_W / 2, deltaY() - DELTA_H / 2, DELTA_W, DELTA_H)) drawDelta();
  int bx, by, bw, bh;
  batteryBox(bx, by, bw, bh);
  if (hit(bx, by, bw, bh)) paintBattery();
  if (lifeLayout == L_HISTORY && hit(HIST_X, HIST_Y, HIST_W, HIST_H)) paintHistory();
}

// draws the whole life screen into the framebuffer (no flush)
void paintLife() {
  prepLifeBg();
  markerX = markerY = -1;
  restoreBg(0, 0, W, H);                // ring / ticks / hints / halo / life bar included
  paintNumber();
  drawDelta();
  drawBattery();
  paintHistory();
  drawMarker();
  markDirty(0, 0, W, H);
  lifeDirty = deltaDirty = false;
}

void fullRedraw() {
  paintLife();
  flush();
}

