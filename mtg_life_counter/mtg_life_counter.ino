  fb.fillRect(CX - DICE_NUM_W / 2, DICE_NUM_Y - DICE_NUM_H / 2, DICE_NUM_W, DICE_NUM_H, TFT_BLACK);
  drawBig(*FONTS[fontIdx].xl, String(v), CX, DICE_NUM_Y, color);
