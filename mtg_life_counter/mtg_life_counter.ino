// ---- custom themes, sent from the web page over BLE ----
// Each slot holds one record: a 64-byte header, a 256-color RGB565 palette and the
// 240x240 background as palette indices. The background already has the ring and
// any decoration; the firmware draws the number, "+3", battery and dot on top and
// repaints from the image (read straight from flash) to erase them.
struct CustomTheme {
  uint32_t magic;                       // CT_MAGIC ("MTGT")
  uint32_t len;                         // whole record, header included (CT_RECORD)
  uint32_t crc;                         // CRC-32 of bytes [12, len)
  char     name[20];
  uint16_t num, acc, acc2, muted, fill, plus, minus, warn[3];   // RGB565
  uint8_t  fx;                          // FX_NONE / FX_SHADOW / FX_GRAD (on the life number)
  int8_t   fxDx, fxDy;                  // shadow offset (clamped to +-3)
  uint8_t  font;                        // 1..FONT_COUNT: font (index + 1) to switch to when chosen; 0 = keep
  uint16_t fxColor[3];                  // shadow color, or gradient top / middle / bottom
  uint16_t reserved2;
};
