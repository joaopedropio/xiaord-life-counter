// ---- screen auto-off ----
// GC9A01: 0x28 display off, 0x10 sleep in / 0x11 sleep out, 0x29 display on.
// The panel keeps its RAM while asleep; we still repaint everything on wake.
void screenSleep() {
  DBG("screen off");
  asleep = true;
  wantMarkerX = wantMarkerY = -1;
  tickWant = -1;
  analogWrite(BACKLIGHT, 0);
  tft.writecommand(0x28);
  tft.writecommand(0x10);
}

void screenWake() {
  DBG("screen on");
  asleep = false;
  tft.writecommand(0x11);
  delay(120);                           // sleep-out settle time (datasheet)
  tft.writecommand(0x29);
  markDirty(0, 0, W, H);
  flush();
  applyBrightness();
}

void openMenu() {
  DBG("menu open");
  menuCur = M_BACK;                     // carousel / list start on "back": a stray tap is harmless
  drawMenu();
}

void closeMenu() {
  screen = S_LIFE;
  fullRedraw();
  applyBrightness();                    // leaving the brightness screen / battery re-read
}

void resetGame(int start) {
  startingLife = start;
  life = start;
  pendingDelta = 0;
  histCount = 0;
  requestSave();
}

void onMenuTap(int x, int y) {
  int item;
  if (menuLayout == ML_CAROUSEL) {      // the big circle runs the item, the neighbors move to it
    auto near = [&](int cx, int cy, int r) { int dx = x - cx, dy = y - cy; return dx * dx + dy * dy <= r * r; };
    if (near(CX, 108, 48)) item = menuCur;
    else if (near(40, 108, 28))  { menuCur = (menuCur + M_COUNT - 1) % M_COUNT; drawMenu(); return; }
    else if (near(200, 108, 28)) { menuCur = (menuCur + 1) % M_COUNT; drawMenu(); return; }
    else return;
  } else if (menuLayout == ML_LIST) {   // the middle row runs the item, the others scroll to it
    int o = constrain((int)lroundf((y - CY) / 44.0f), -2, 2);
    if (o != 0) { menuCur = (menuCur + o + M_COUNT) % M_COUNT; drawMenu(); return; }
    item = menuCur;
  } else item = menuHit(x, y);
  DBG("menu tap item=%d", item);
  switch (item) {
    case M_RESET: resetGame(startingLife); break;
    case M_20:    resetGame(20); break;
    case M_40:    resetGame(40); break;
    case M_DICE:  drawDicePicker(); return;
    case M_LIGHT: drawBrightness(); return;
    case M_THEME: drawThemePicker(); return;
    case M_FONT:  previewNum = life; drawFontPicker(); return;
    case M_BACK:  break;
    default:      return;               // tapped outside the buttons: keep the menu open
  }
  closeMenu();
}

void onDicePickTap(int x, int y) {
  int i = buttonAt(DICE_BTNS, DICE_COUNT + 1, x, y);
  DBG("dice pick tap item=%d", i);
  if (i < 0) return;                    // outside the buttons: stay
  if (i == DICE_COUNT) closeMenu();     // Voltar
  else rollDice(DICE_SIDES[i]);
}

void onThemeTap(int x, int y) {
  int i = buttonAt(THEME_BTNS, THEME_BTN_COUNT, x, y);
  DBG("theme tap item=%d", i);
  if (i < 0) return;
  if (i == THEME_LAYOUT) { drawLayoutPicker(); return; }
  if (i == THEME_BT) { bleOn(); drawBleScreen(); return; }
  if (i >= THEME_COUNT && i < THEME_COUNT + CT_SLOTS && !ctValid[i - THEME_COUNT]) return;  // empty slot
  if (i < THEME_COUNT + CT_SLOTS && i != theme) { theme = i; themeChanged(); applyThemeFont(); requestSave(); }
  closeMenu();
}

void onScreenTap(int x, int y) {
  switch (screen) {
    case S_MENU:        onMenuTap(x, y); break;
    case S_DICE_PICK:   onDicePickTap(x, y); break;
    case S_DICE_RESULT: closeMenu(); break;   // any tap leaves the result
    case S_BRIGHT:      onBrightnessTap(x, y); break;
    case S_THEME:       onThemeTap(x, y); break;
    case S_FONT:        onFontTap(x, y); break;
    case S_LAYOUT:      onLayoutTap(x, y); break;
    case S_BLE:         onBleTap(x, y); break;
    default: break;
  }
}

// Seed random() from the nRF52 hardware RNG (called before the SoftDevice starts).
void seedRandom() {
  uint32_t seed = 0;
  NRF_RNG->CONFIG = RNG_CONFIG_DERCEN_Enabled << RNG_CONFIG_DERCEN_Pos;  // bias correction
  NRF_RNG->TASKS_START = 1;
  for (int i = 0; i < 4; i++) {
    NRF_RNG->EVENTS_VALRDY = 0;
    while (!NRF_RNG->EVENTS_VALRDY) {}
    seed = (seed << 8) | NRF_RNG->VALUE;
  }
  NRF_RNG->TASKS_STOP = 1;
  randomSeed(seed);
}

// ================= Logic =================
void changeLife(int d) {
  int nv = constrain(life + d, -999, 999);
  if (nv == life) return;
  pendingDelta += nv - life;
  life = nv;
  lastChangeMs = millis();
  lifeDirty = deltaDirty = true;
  requestSave();
}

// +/- from taps, holds and the rim: changes whatever the current screen controls
void nudge(int d) {
  if (screen == S_BRIGHT) changeBrightness(d);
  else if (screen == S_FONT) {
    previewNum = constrain(previewNum + d, -999, 999);
    fontDirty = true;
  }
  else if (screen == S_MENU) {          // carousel / list: rim scrolls
    menuCur = (menuCur + (d > 0 ? 1 : M_COUNT - 1)) % M_COUNT;
    menuDirty = true;
  }
  else changeLife(d);
}

float angleOf(int x, int y) {
  return atan2f((float)(y - CY), (float)(x - CX)) * 180.0f / PI; // clockwise positive
}

int distOf(int x, int y) {
  int ddx = x - CX, ddy = y - CY;
  return (int)sqrtf((float)(ddx * ddx + ddy * ddy));
}

Zone zoneOf(int x, int y) {
  int d = distOf(x, y);
  if (screen == S_BRIGHT) {
    int b = buttonAt(BRIGHT_BTNS, B_COUNT, x, y);
    if (b == B_MINUS) return Z_MINUS;
    if (b == B_PLUS)  return Z_PLUS;
    if (b < 0 && d >= RIM_INNER_R) return Z_RIM;
    return Z_MENU;                      // OK (or empty space): handled on touch end
  }
  if (screen == S_FONT) {                // buttons on touch end; elsewhere like the life screen
    if (buttonAt(FONT_BTNS, F_COUNT, x, y) >= 0) return Z_MENU;
    if (d >= RIM_INNER_R) return Z_RIM;
    return (x >= CX) ? Z_PLUS : Z_MINUS;
  }
  if (screen == S_MENU && (menuLayout == ML_CAROUSEL || menuLayout == ML_LIST) && d >= RIM_INNER_R)
    return Z_RIM;                       // a rim touch that doesn't move is still a tap
  if (screen != S_LIFE) return Z_MENU;
  if (d >= RIM_INNER_R) return Z_RIM;
  if (d < CENTER_R)     return Z_CENTER;
  return (x >= CX) ? Z_PLUS : Z_MINUS;
}

void onTouchStart(int x, int y) {
  lastActivityMs = millis();
  if (asleep) {                         // this touch only wakes the screen
    screenWake();
    touching = true;
    zone = Z_NONE;
    DBG("wake touch ignored");
    return;
  }
  touching = true;
  touchX = x; touchY = y;
  touchStart = millis();
  lastHoldMs = touchStart;
  holdFired = false;
  angleAccum = 0;
  rimMoved = false;
  zone = zoneOf(x, y);
  lastAngle = angleOf(x, y);
  DBG("touch start x=%d y=%d dist=%d zone=%d", x, y, distOf(x, y), zone);
}

void onTouchMove(int x, int y) {
  if (zone != Z_RIM) return;
  float a = angleOf(x, y);
  float d = a - lastAngle;
  if (d > 180)  d -= 360;
  if (d < -180) d += 360;
  lastAngle = a;
  if (fabsf(d) > MAX_JUMP_DEG) {      // glitch or finger lifted/replaced: re-anchor, don't count
    DBG("jump ignored %.0f deg", d);
    return;
  }
  if (INVERT_DIRECTION) d = -d;
  angleAccum += d;

  const float step = (screen == S_BRIGHT) ? BRIGHT_STEP_DEG : (screen == S_MENU ? MENU_STEP_DEG : STEP_DEGREES);
  while (angleAccum >= step)  { nudge(+1); angleAccum -= step; rimMoved = true; }
  while (angleAccum <= -step) { nudge(-1); angleAccum += step; rimMoved = true; }

  if (screen != S_LIFE) return;         // the dot is only drawn on the life screen
  if (lifeLayout == L_TICKS) {          // ticks light up instead of the dot
    tickWant = fmodf(a + 90 + 360, 360);
    return;
  }

  // marker dot snapped onto the ring
  float rad = a * PI / 180.0f;
  wantMarkerX = CX + (int)(98 * cosf(rad));
  wantMarkerY = CY + (int)(98 * sinf(rad));
}

// Called every loop while touching, even with no new report (finger held still).
void checkHold() {
  if (!touching || (zone != Z_PLUS && zone != Z_MINUS)) return;
  if (millis() - lastHoldMs >= HOLD_MS) {
    lastHoldMs = millis();
    holdFired = true;
    nudge(zone == Z_PLUS ? +10 : -10);
  }
}

void onTouchEnd() {
  unsigned long held = millis() - touchStart;
  DBG("touch end zone=%d held=%lu life=%d", zone, held, life);
  touching = false;
  wantMarkerX = wantMarkerY = -1;
  tickWant = -1;
  switch (zone) {
    case Z_RIM:    if (screen == S_MENU && !rimMoved) onScreenTap(touchX, touchY); break;
    case Z_PLUS:   if (!holdFired) nudge(+1); break;
    case Z_MINUS:  if (!holdFired) nudge(-1); break;
    case Z_CENTER: if (held < MENU_TAP_MAX_MS) openMenu(); break;
    case Z_MENU:   onScreenTap(touchX, touchY); break;
    default: break;
  }
  zone = Z_NONE;
}

// ================= Arduino =================
// ================= BLE: themes from the web page =================
// One GATT service (UUIDs 4d5447xx-6c69-6665-2d63-6f756e746572, "MTG.life-counter"):
//   CTRL (write + notify): commands, answered by a notify starting with the same byte
//     01                    INFO   -> 01 ver slots validMask theme builtinCount enabled mtu
//     02 slot size(u32)     BEGIN  -> 02 status        (erases the slot, then accepts DATA)
//     04                    END    -> 04 status        (CRC check; 0 = slot valid)
//     05 theme              SELECT -> 05 status        (0..5 built in, 6.. custom slots)
//     06 bytes...           DATA via CTRL, no reply (v2). Bluefy on iOS never delivers
//                           writes to DATA, with or without response, but CTRL works.
//   DATA (write without response): the record bytes, in order. Every flash page
//     written is acknowledged with 03 bytesWritten(u32); the page keeps at most
//     RX_SIZE/2 bytes in flight past the last ack, so the buffer never overflows.
//   Errors: 7F code (1 = buffer overflow, 2 = unexpected data).
// Callbacks run in the BLE task: they only queue; loop() does the work.
const uint8_t PROTO_VERSION = 2;      // 2: DATA bytes can also come through CTRL (06 ...)
const uint8_t UUID_SVC[16]  = { 0x72,0x65,0x74,0x6e,0x75,0x6f,0x63,0x2d,0x65,0x66,0x69,0x6c,0x00,0x47,0x54,0x4d };
const uint8_t UUID_CTRL[16] = { 0x72,0x65,0x74,0x6e,0x75,0x6f,0x63,0x2d,0x65,0x66,0x69,0x6c,0x01,0x47,0x54,0x4d };
const uint8_t UUID_DATA[16] = { 0x72,0x65,0x74,0x6e,0x75,0x6f,0x63,0x2d,0x65,0x66,0x69,0x6c,0x02,0x47,0x54,0x4d };
BLEService        mtgSvc(UUID_SVC);
BLECharacteristic ctrlChr(UUID_CTRL);
BLECharacteristic dataChr(UUID_DATA);

const uint32_t RX_SIZE = 16384;
uint8_t rxBuf[RX_SIZE];
volatile uint32_t rxHead = 0, rxTail = 0;
volatile bool rxOverflow = false;
volatile uint8_t cmdBuf[20];
volatile uint8_t cmdLen = 0;

enum { UP_IDLE, UP_RECV } upState = UP_IDLE;
// connection interval in 1.25 ms units: 15 ms while a theme is coming in (the shortest
// iOS accepts, and it must be asked as min = max), 30 ms otherwise to save battery
const uint16_t CONN_FAST = 12, CONN_IDLE = 24;
unsigned long upStartMs = 0;
int      upSlot = 0;
uint32_t upSize = 0, upWritten = 0, upFill = 0;
uint8_t  upPage[PAGE_SIZE] __attribute__((aligned(4)));

uint32_t crc32(const uint8_t *p, uint32_t n) {
  uint32_t c = 0xFFFFFFFF;
  while (n--) {
    c ^= *p++;
    for (int k = 0; k < 8; k++) c = (c >> 1) ^ (0xEDB88320 & (0 - (c & 1)));
  }
  return ~c;
}

bool ctCheck(int slot) {
  const CustomTheme *h = ctHeader(slot);
  return ctEnabled && h->magic == CT_MAGIC && h->len == CT_RECORD &&
         h->crc == crc32((const uint8_t *)h + 12, h->len - 12);
}

extern uint32_t __etext, __data_start__, __data_end__;

void ctInit() {
  uint32_t appEnd = (uint32_t)&__etext + ((uint32_t)&__data_end__ - (uint32_t)&__data_start__);
  ctEnabled = appEnd <= CT_BASE;
  if (!ctEnabled) DBG("firmware ends at 0x%lx, past the theme slots (0x%lx): custom themes off", appEnd, CT_BASE);
  for (int k = 0; k < CT_SLOTS; k++) ctValid[k] = ctCheck(k);
  if (theme >= THEME_COUNT && !ctValid[theme - THEME_COUNT]) theme = 0;
  themeChanged();
  DBG("custom themes: app ends 0x%lx, slots valid %d %d", appEnd, ctValid[0], ctValid[1]);
}

void onDataWrite(uint16_t, BLECharacteristic *, uint8_t *data, uint16_t len);
void onCtrlWrite(uint16_t conn, BLECharacteristic *chr, uint8_t *data, uint16_t len) {
  bleLastMs = millis();
  if (len > 1 && data[0] == 0x06) { onDataWrite(conn, chr, data + 1, len - 1); return; }
  if (cmdLen || len == 0 || len > sizeof(cmdBuf)) return;   // one command at a time
  for (int i = 0; i < len; i++) cmdBuf[i] = data[i];
  cmdLen = len;
}

uint16_t bleConn = 0;                    // handle of the current (only) connection
#if DEBUG
volatile uint32_t rxBytes = 0, rxWrites = 0, rxMinLen = 9999, rxMaxLen = 0;   // diag
#endif
void onDataWrite(uint16_t, BLECharacteristic *, uint8_t *data, uint16_t len) {
  bleLastMs = millis();
#if DEBUG
  rxBytes += len; rxWrites++; if (len < rxMinLen) rxMinLen = len; if (len > rxMaxLen) rxMaxLen = len;
#endif
  for (int i = 0; i < len; i++) {
    uint32_t n = (rxHead + 1) % RX_SIZE;
    if (n == rxTail) { rxOverflow = true; return; }
    rxBuf[rxHead] = data[i];
    rxHead = n;
  }
}

void bleReply(const uint8_t *p, int n) {
  if (Bluefruit.connected()) ctrlChr.notify(p, n);
}
void bleReply2(uint8_t a, uint8_t b) { uint8_t r[2] = { a, b }; bleReply(r, 2); }

// shows the life screen with the (possibly new) theme, waking the panel if needed
void showThemeNow() {
  lastActivityMs = millis();
  if (screen != S_LIFE) screen = S_LIFE;
  fullRedraw();
  if (asleep) screenWake();
  else applyBrightness();
}

void bleCommand(const uint8_t *c, int n) {
  switch (c[0]) {
    case 0x01: {
      uint8_t mask = 0;
      for (int k = 0; k < CT_SLOTS; k++) if (ctValid[k]) mask |= 1 << k;
      // byte 7 = current ATT MTU (older pages ignore it; they must size DATA writes to MTU-3)
      BLEConnection *conn = Bluefruit.Connection(bleConn);
      uint16_t mtu = conn ? conn->getMtu() : 23;
      uint8_t r[8] = { 0x01, PROTO_VERSION, CT_SLOTS, mask, (uint8_t)theme, (uint8_t)THEME_COUNT, ctEnabled,
                       (uint8_t)(mtu > 255 ? 255 : mtu) };
      bleReply(r, 8);
      DBG("ble info, mtu %d", mtu);
      break;
    }
    case 0x02: {
      if (n < 6) { bleReply2(0x02, 1); break; }
      int slot = c[1];
      uint32_t size = c[2] | (c[3] << 8) | (c[4] << 16) | ((uint32_t)c[5] << 24);
      if (!ctEnabled) { bleReply2(0x02, 2); break; }
      if (slot >= CT_SLOTS || size != CT_RECORD) { bleReply2(0x02, 1); break; }
      if (theme == THEME_COUNT + slot) {  // replacing the theme on screen: fall back meanwhile
        theme = 0;
        if (screen == S_LIFE && !asleep) { fullRedraw(); }
      }
      ctValid[slot] = false;
      upState = UP_IDLE;
      // pages are erased one by one as their data arrives (bleTask), so the ~2.7 s of
      // erasing overlaps the transfer; an upload cut short before the first page leaves
      // the old record intact (its CRC still matches on the next boot)
      DBG("ble begin slot %d size %lu, mtu %d", slot, size, Bluefruit.Connection(bleConn) ? Bluefruit.Connection(bleConn)->getMtu() : -1);
      upSlot = slot; upSize = size; upWritten = 0; upFill = 0;
      rxTail = rxHead; rxOverflow = false;
      upState = UP_RECV;
      upStartMs = millis();
      if (BLEConnection *bc = Bluefruit.Connection(bleConn)) bc->requestConnectionParameter(CONN_FAST);
      bleReply2(0x02, 0);
      break;
    }
    case 0x04: {
      bool ok = upState == UP_RECV && upWritten == upSize && ctCheck(upSlot);
      upState = UP_IDLE;
      ctValid[upSlot] = ok;
      BLEConnection *bc = Bluefruit.Connection(bleConn);
      DBG("ble end slot %d: %s, %lu ms since begin, interval %d", upSlot, ok ? "valid" : "INVALID",
          millis() - upStartMs, bc ? bc->getConnectionInterval() : -1);
      if (bc) bc->requestConnectionParameter(CONN_IDLE);
      bleReply2(0x04, ok ? 0 : 1);
      if (screen == S_THEME) drawThemePicker();
      break;
    }
    case 0x05: {
      int t = n > 1 ? c[1] : -1;
      bool ok = (t >= 0 && t < THEME_COUNT) || (t >= THEME_COUNT && t < THEME_COUNT + CT_SLOTS && ctValid[t - THEME_COUNT]);
      if (ok) {
        theme = t;
        themeChanged();
        applyThemeFont();
        requestSave();
        showThemeNow();
        DBG("ble theme %d", theme);
      }
      bleReply2(0x05, ok ? 0 : 1);
      break;
    }
    default:
      bleReply2(0x7F, 3);
  }
}

void bleTask() {
  if (cmdLen) {
    uint8_t c[20];
    int n = cmdLen;
    for (int i = 0; i < n; i++) c[i] = cmdBuf[i];
    cmdLen = 0;
    bleCommand(c, n);
  }
  if (rxOverflow) {
    rxOverflow = false;
    rxTail = rxHead;
    upState = UP_IDLE;
    bleReply2(0x7F, 1);
    DBG("ble rx overflow");
  }
  if (upState != UP_RECV) { rxTail = rxHead; return; }   // stray data is dropped
  while (rxTail != rxHead) {
    if (upWritten + upFill >= upSize) { upState = UP_IDLE; bleReply2(0x7F, 2); return; }
    upPage[upFill++] = rxBuf[rxTail];
    rxTail = (rxTail + 1) % RX_SIZE;
    if (upFill == PAGE_SIZE || upWritten + upFill == upSize) {
      uint32_t words = (upFill + 3) / 4;
      for (uint32_t i = upFill; i < words * 4; i++) upPage[i] = 0xFF;
      flashErasePage(CT_BASE + upSlot * CT_SLOT_BYTES + upWritten);   // upWritten is page aligned here
      flashWriteWords(CT_BASE + upSlot * CT_SLOT_BYTES + upWritten, (const uint32_t *)upPage, words);
      upWritten += upFill;
      upFill = 0;
      uint8_t r[5] = { 0x03, (uint8_t)upWritten, (uint8_t)(upWritten >> 8), (uint8_t)(upWritten >> 16), (uint8_t)(upWritten >> 24) };
      bleReply(r, 5);
      return;                             // one page per loop keeps the touch responsive
    }
  }
}

// ---- Bluetooth on / off ----
void bleOn() {
  bleOnMs = millis();
  if (bleConnected || bleAdvertising) return;
  Bluefruit.Advertising.setInterval(160, 1600);  // 100 ms for the first 30 s, then 1 s
  Bluefruit.Advertising.setFastTimeout(30);
  Bluefruit.Advertising.start(0);
  bleAdvertising = true;
  DBG("ble advertising on");
}

void bleOff() {
  if (bleAdvertising) Bluefruit.Advertising.stop();
  bleAdvertising = false;
  if (bleConnected) Bluefruit.disconnect(bleConn);
  DBG("ble off");
}

// timeouts; called every loop
void bleWatch() {
  if (bleAdvertising && !bleConnected && millis() - bleOnMs > BLE_ADV_S * 1000UL) {
    DBG("ble advertising timed out");
    bleOff();
    if (screen == S_BLE) closeMenu();
  }
  if (bleConnected && upState == UP_IDLE && millis() - bleLastMs > BLE_IDLE_S * 1000UL) {
    DBG("ble idle, disconnecting");
    bleLastMs = millis();               // don't ask again every loop while it goes
    Bluefruit.disconnect(bleConn);
  }
  if (bleUiDirty && screen == S_BLE && !asleep) { bleUiDirty = false; drawBleScreen(); }
}

// Bluetooth screen: status, a hint for the web page and "Desligar" / back
enum { BT_OFF, BT_BACK, BT_COUNT };
const Btn BLE_BTNS[BT_COUNT] = {
  { 52, 168, 84, 36, "Desligar" }, { 144, 168, 44, 36, nullptr, I_BACK },
};

void drawBleScreen() {
  showScreen(S_BLE);
  bool on = bleConnected || bleAdvertising;
  drawIcon(I_BT, CX, 58, on ? 0x3CBF : GREY, TFT_BLACK, 1.6f);
  fb.setTextDatum(MC_DATUM);
  fb.setTextPadding(0);
  fb.setTextColor(TFT_WHITE);
  fb.drawString(bleConnected ? "Conectado" : (on ? "Esperando..." : "Desligado"), CX, 104, 4);
  fb.setTextColor(GREY);
  if (bleConnected) fb.drawString("Envie o tema pelo site", CX, 136, 2);
  else if (on) {
    fb.drawString("No site, toque em Conectar", CX, 130, 2);
    fb.drawString("e escolha \"MTG Life\"", CX, 148, 2);
  }
  drawButton(BLE_BTNS[BT_OFF], on ? TFT_RED : GREY);
  drawButton(BLE_BTNS[BT_BACK], btnBorder());
  markDirty(0, 0, W, H);
  flush();
}

void onBleTap(int x, int y) {
  int i = buttonAt(BLE_BTNS, BT_COUNT, x, y);
  if (i == BT_OFF) { bleOff(); closeMenu(); }
  else if (i == BT_BACK) closeMenu();   // a connection keeps going; advertising times out by itself
}

void onBleConnect(uint16_t conn) {
  bleConn = conn;
  bleConnected = true;
  bleAdvertising = false;               // the stack stops advertising once connected
  bleLastMs = millis();
  bleUiDirty = true;
#if DEBUG
  rxBytes = rxWrites = rxMaxLen = 0; rxMinLen = 9999;
#endif
  BLEConnection *c = Bluefruit.Connection(conn);
  DBG("ble connected, mtu %d, interval %d", c ? c->getMtu() : -1, c ? c->getConnectionInterval() : -1);
  if (c) c->requestPHY(BLE_GAP_PHY_2MBPS);   // falls back to 1M if the central can't
}
void onBleDisconnect(uint16_t conn, uint8_t reason) {
  bleConnected = false;
  bleUiDirty = true;
  DBG("ble disconnected, reason 0x%02x; rx %lu bytes in %lu writes (len %lu..%lu)", reason, rxBytes, rxWrites, rxMinLen, rxMaxLen);
  upState = UP_IDLE;
}

void bleBegin() {
  Bluefruit.autoConnLed(false);         // no blinking blue LED
  Bluefruit.configPrphBandwidth(BANDWIDTH_MAX);   // MTU 247, bigger queues
  Bluefruit.begin();
  Bluefruit.setTxPower(4);              // dBm; the display sits over the antenna
  Bluefruit.setName("MTG Life");
  Bluefruit.Periph.setConnectCallback(onBleConnect);
  Bluefruit.Periph.setDisconnectCallback(onBleDisconnect);

  mtgSvc.begin();
  ctrlChr.setProperties(CHR_PROPS_WRITE | CHR_PROPS_NOTIFY);
  ctrlChr.setPermission(SECMODE_OPEN, SECMODE_OPEN);
  ctrlChr.setMaxLen(244);               // commands are short; 06 + data fills an MTU-247 write
  ctrlChr.setWriteCallback(onCtrlWrite);
  ctrlChr.begin();
  dataChr.setProperties(CHR_PROPS_WRITE | CHR_PROPS_WRITE_WO_RESP);
  dataChr.setPermission(SECMODE_NO_ACCESS, SECMODE_OPEN);
  dataChr.setMaxLen(244);
  dataChr.setWriteCallback(onDataWrite);
  dataChr.begin();

  Bluefruit.Advertising.addFlags(BLE_GAP_ADV_FLAGS_LE_ONLY_GENERAL_DISC_MODE);
  Bluefruit.Advertising.addService(mtgSvc);
  Bluefruit.ScanResponse.addName();
  Bluefruit.Advertising.restartOnDisconnect(false);   // off until "Conectar" on the device
}

void setup() {
#if DEBUG
  Serial.begin(115200);
#endif
  pinMode(TOUCH_INT, INPUT_PULLUP);
  pinMode(BACKLIGHT, OUTPUT);
  digitalWrite(BACKLIGHT, LOW);         // dark until the first real frame is on the panel
  Wire.begin();

  loadState();

  tft.init();
  tft.setRotation(0);

  fb.setColorDepth(16);
  fbPix = (uint16_t *)fb.createSprite(W, H);
  if (!fbPix) {
    digitalWrite(BACKLIGHT, HIGH);
    tft.fillScreen(TFT_BLACK);
    tft.setTextColor(TFT_RED, TFT_BLACK);
    tft.drawString("no RAM for framebuffer", 20, 110, 2);
    while (true) delay(1000);
  }

  seedRandom();                         // before BLE: the SoftDevice then owns the RNG
  bleBegin();
  ctInit();

  unsigned long t1 = micros();
  fullRedraw();
  applyBrightness();                    // light up only once the first frame is on the panel
  unsigned long frameUs = micros() - t1;

#if DEBUG
  // On USB, give the serial monitor up to 3 s to attach (the life screen is already up).
  // On battery there is no host, so don't wait at all.
  if (usbPowered()) {
    unsigned long t0 = millis();
    while (!Serial && millis() - t0 < 3000) delay(10);
  }
#endif
#if DEBUG
  // bootloader identity: its version string lives in the bootloader area (0xF4000..)
  for (uint32_t addr = 0xF4000; addr < 0x100000 - 32; addr++) {
    const char *p = (const char *)addr;
    if (memcmp(p, "UF2 Bootloader", 14) == 0 || memcmp(p, "Bootloader v", 12) == 0) {
      char buf[96];
      int n = 0;
      while (n < 95 && p[n] >= 0x20 && p[n] < 0x7F) { buf[n] = p[n]; n++; }
      buf[n] = 0;
      DBG("bootloader @0x%lx: %s", addr, buf);
      break;
    }
  }
#endif
  lastActivityMs = millis();
  DBG("MTG Life Counter v" FW_VERSION " boot (life=%d theme=%d font=%d start=%d bright=%d sleep=%ds), first frame in %lu us", life, theme, fontIdx, startingLife, brightness, SLEEP_SECS[sleepIdx], frameUs);
}

#if DEBUG
// Test commands over the serial port (one per line), so screens can be exercised
// without touching the panel:  font N | life N | menu | dice N | home
bool serialUpload = false;              // "ctup N": the next CT_RECORD bytes are a theme

void serialCommands() {
  static char line[32];
  static int n = 0;
  if (serialUpload) {                   // binary mode: feed the BLE upload path
    while (Serial.available() && (rxHead + 1) % RX_SIZE != rxTail) {
      rxBuf[rxHead] = Serial.read();
      rxHead = (rxHead + 1) % RX_SIZE;
    }
    if (upState != UP_RECV || upWritten == upSize) {
      serialUpload = false;
      if (upState == UP_RECV) {
        uint8_t e = 0x04;
        bleCommand(&e, 1);
        uint8_t sel[2] = { 0x05, (uint8_t)(THEME_COUNT + upSlot) };
        bleCommand(sel, 2);
      }
    }
    return;
  }
  while (Serial.available()) {
    char c = Serial.read();
    if (c != '\n' && c != '\r') { if (n < 31) line[n++] = c; continue; }
    if (n == 0) continue;
    line[n] = 0;
    n = 0;
    int v = 0;
    unsigned long t0 = micros();
    if (sscanf(line, "font %d", &v) == 1 && v >= 0 && v < FONT_COUNT) { fontIdx = v; drawFontPicker(); }
    else if (sscanf(line, "life %d", &v) == 1) { life = constrain(v, -999, 999); closeMenu(); }
    else if (sscanf(line, "dice %d", &v) == 1 && v > 0) rollDice(v);
    else if (sscanf(line, "ctup %d", &v) == 1) {
      uint8_t c[6] = { 0x02, (uint8_t)v, (uint8_t)CT_RECORD, (uint8_t)(CT_RECORD >> 8), (uint8_t)(CT_RECORD >> 16), 0 };
      bleCommand(c, 6);
      serialUpload = upState == UP_RECV;
    }
    else if (sscanf(line, "bat %d", &v) == 1) {
      batOverride = constrain(v, -1, 100);
      lastBatteryMs = millis() - 31000; // re-read (and apply) on this loop
    }
    else if (sscanf(line, "theme %d", &v) == 1 && v >= 0 && v < THEME_COUNT + CT_SLOTS) { theme = v; themeChanged(); closeMenu(); }
    else if (sscanf(line, "layout %d", &v) == 1) { lifeLayout = v / 10 % LIFE_LAYOUTS; menuLayout = v % 10 % MENU_LAYOUTS; closeMenu(); }
    else if (sscanf(line, "menubg %d", &v) == 1) { menuBg = v; closeMenu(); }
    else if (sscanf(line, "cur %d", &v) == 1) { menuCur = v % M_COUNT; drawMenu(); }
    else if (strcmp(line, "picker") == 0) drawLayoutPicker();
    else if (strcmp(line, "bt") == 0) { bleOn(); drawBleScreen(); }
    else if (strcmp(line, "themes") == 0) drawThemePicker();
    else if (strcmp(line, "shot") == 0) {   // raw framebuffer dump (RGB565, byte-swapped) after "SHOT\n"
      delay(300);
      Serial.write("SHOT\n");
      const uint8_t *q = (const uint8_t *)fbPix;
      size_t left = W * H * 2;
      while (left) { size_t k = Serial.write(q, left > 512 ? 512 : left); q += k; left -= k; if (!k) delay(1); }
      Serial.flush();
      continue;
    }
    else if (strcmp(line, "menu") == 0) openMenu();
    else if (strcmp(line, "home") == 0) closeMenu();
    else { DBG("cmd? '%s'", line); continue; }
    DBG("cmd '%s' done in %lu us", line, micros() - t0);
  }
}
#endif

void loop() {
#if DEBUG
  serialCommands();
  static unsigned long lastBeat = 0;
  if (millis() - lastBeat > 2000) {
    lastBeat = millis();
    DBG("alive t=%lu life=%d touching=%d i2c err=%lu timeouts=%lu rx=%lu/%lu up=%d written=%lu",
        millis(), life, touching, i2cErrors, i2cTimeouts, rxBytes, rxWrites, upState, upWritten);
  }
#endif
  int x, y;
  if (touchReady() && readTouch(x, y)) {
    lastTouchReadMs = millis();
    lastActivityMs = lastTouchReadMs;
    if (!touching) onTouchStart(x, y);
    else           onTouchMove(x, y);
  } else if (touching && millis() - lastTouchReadMs > RELEASE_MS) {
    onTouchEnd();
  }
  checkHold();
  bleTask();
  bleWatch();

  // clear the "+3" indicator 2 s after the last change
  if (pendingDelta != 0 && millis() - lastChangeMs > 2000) {
    pushHistory(pendingDelta);
    pendingDelta = 0;
    deltaDirty = true;
  }

  // refresh battery every 30 s, or right away when USB is plugged / unplugged
  if (millis() - lastBatteryMs > 30000 || (screen == S_LIFE && usbPowered() != shownUsb)) {
    lastBatteryMs = millis();
    bool wasLow = lowBattery;
    drawBattery();
    if (lowBattery != wasLow && !asleep) applyBrightness();
  }

  // auto-off after SLEEP_SECS of no touches (LOW_BAT_SLEEP_S in low-battery mode);
  // menus / dice / brightness get at least MENU_MIN_SLEEP_S so a short setting
  // doesn't blank them mid-choice
  int sleepS = lowBattery ? LOW_BAT_SLEEP_S : SLEEP_SECS[sleepIdx];
  if (sleepS > 0 && screen != S_LIFE) sleepS = max(sleepS, MENU_MIN_SLEEP_S);
  if (screen == S_BLE && (bleAdvertising || bleConnected)) lastActivityMs = millis();
  if (!asleep && !touching && sleepS > 0 &&
      millis() - lastActivityMs > (unsigned long)sleepS * 1000UL) {
    screenSleep();
  }

  // save to flash once things have been quiet for a moment (and not mid-touch)
  if (saveDirty && !touching && millis() - saveDirtySince > SAVE_DELAY_MS) saveState();

  // one frame: draw what changed into the framebuffer, then push the dirty rect
  static unsigned long lastFrame = 0;
  if (!asleep && (screen == S_LIFE || screen == S_BRIGHT || screen == S_FONT || screen == S_MENU) &&
      millis() - lastFrame >= FRAME_MS) {
    lastFrame = millis();
    if (screen == S_LIFE) {
      if (lifeDirty)  { lifeDirty = false;  drawLife(); }
      if (deltaDirty) { deltaDirty = false; drawDelta(); }
      if (lifeLayout == L_TICKS) drawTicks();
    } else if (screen == S_MENU && menuDirty) {
      menuDirty = false;
      paintMenu();
    } else if (screen == S_BRIGHT && brightDirty) {
      brightDirty = false;
      drawBrightnessValue();
    } else if (screen == S_FONT && fontDirty) {
      fontDirty = false;
      drawFontSample();
    }
    drawMarker();
    flush();
  }

  delay(asleep ? 20 : 2);               // asleep: poll the touch less often
}
